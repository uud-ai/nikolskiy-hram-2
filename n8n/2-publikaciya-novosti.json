    {
      "parameters": {
        "jsCode": "// Пускаем только сообщения из вашего чата и ищем в них ссылку\nconst cfg = $('Настройки').first().json;\nconst msg = $('Сообщение боту').first().json.message || {};\nif (String(msg.chat?.id) !== String(cfg.allowedChatId)) return [];   // чужие сообщения молча игнорируем\nconst m = (msg.text || msg.caption || '').match(/https?:\\/\\/[^\\s<>\"]+/);\nreturn [{ json: { chatId: msg.chat.id, url: m ? m[0] : '', hasUrl: !!m } }];"
      },
