      "id": "5eed09b0-7bc2-4ae9-9a8a-21dafe6e1279",
      "name": "Загрузка страницы",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        180
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Достаём из HTML-страницы заголовок и текст статьи\nconst html = String($json.data || '');\nconst url = $('Проверка').first().json.url;\nconst meta = (prop) => {\n  const r = new RegExp(`<meta[^>]+(?:property|name)=[\"']${prop}[\"'][^>]*content=[\"']([^\"']*)[\"']`, 'i');\n  const r2 = new RegExp(`<meta[^>]+content=[\"']([^\"']*)[\"'][^>]*(?:property|name)=[\"']${prop}[\"']`, 'i');\n  return (html.match(r) || html.match(r2) || [])[1] || '';\n};\nconst decode = s => s\n  .replace(/&nbsp;/g, ' ').replace(/&quot;/g, '\"').replace(/&#039;|&#39;|&apos;/g, \"'\")\n  .replace(/&laquo;/g, '«').replace(/&raquo;/g, '»').replace(/&mdash;/g, '—').replace(/&ndash;/g, '–')\n  .replace(/&#(\\d+);/g, (_, n) => String.fromCharCode(Number(n)))\n  .replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&');\n\nconst clean = html\n  .replace(/<(script|style|noscript|nav|footer|header|aside|form)[\\s\\S]*?<\\/\\1>/gi, ' ');\nconst paragraphs = [...clean.matchAll(/<p[^>]*>([\\s\\S]*?)<\\/p>/gi)]\n  .map(m => decode(m[1].replace(/<[^>]+>/g, ' ')).replace(/\\s+/g, ' ').trim())\n  .filter(p => p.length > 40);\n\nconst pageTitle = decode(meta('og:title') || (html.match(/<title[^>]*>([\\s\\S]*?)<\\/title>/i) || [])[1] || '').trim();\nlet siteName = decode(meta('og:site_name')).trim();\ntry { if (!siteName) siteName = new URL(url).hostname.replace(/^www\\./, ''); } catch (e) {}\n\nconst articleText = paragraphs.join('\\n\\n').slice(0, 15000);\nif (articleText.length < 200) {\n  throw new Error('Не удалось извлечь текст статьи со страницы. Возможно, это ссылка Google Новостей или сайт отдаёт текст скриптом — откройте статью в браузере и пришлите прямую ссылку.');\n}\nreturn [{ json: { url, pageTitle, siteName, articleText } }];"
      },
      "id": "5229e675-2373-4832-a707-f2edd8ac06da",
      "name": "Текст статьи",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        160
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Ты — редактор новостной ленты сайта православного прихода (Никольский храм, с. Усть-Карск). Перескажи новость для сайта по-русски.\n\nТребования:\n- Используй ТОЛЬКО сведения из текста статьи ниже. Ничего не добавляй и не домысливай: имена, саны, даты, места и цифры — строго как в источнике.\n- Пиши своими словами, не копируй фразы целиком. Спокойный, уважительный тон, принятый в церковной среде.\n- Заголовок — до 90 знаков. Текст — 2–3 коротких абзаца, всего не более 900 знаков. Абзацы разделяй пустой строкой.\n- Если в статье недостаточно сведений для новости, напиши это в поле text.\n\nОтветь строго JSON-объектом без пояснений и без оформления кода:\n{\"title\": \"...\", \"text\": \"...\"}\n\nЗаголовок страницы: {{ $json.pageTitle }}\nИсточник: {{ $json.siteName }}\n\nТекст статьи:\n{{ $json.articleText }}"
      },
      "id": "4719af53-255d-46d8-abd1-4886b62006e9",
      "name": "Пересказ",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        1340,
        140
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
