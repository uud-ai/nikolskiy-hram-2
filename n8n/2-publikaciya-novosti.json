    {
      "parameters": {
        "chatId": "={{ $('Проверка').first().json.chatId }}",
        "text": "Пришлите ссылку на статью (адрес, начинающийся с http), и я подготовлю новость для сайта.",
        "additionalFields": {
          "appendAttribution": false,
          "disable_web_page_preview": true
