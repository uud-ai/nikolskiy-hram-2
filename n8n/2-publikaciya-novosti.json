      "id": "7e276390-abc4-45a7-a335-8802f4dc0bce",
      "name": "Модель OpenAI",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        1340,
        360
      ]
    },
    {
      "parameters": {
        "jsCode": "// Разбираем ответ модели и готовим текст для проверки в Telegram\nconst raw = String($json.text || '').replace(/^```(?:json)?\\s*|\\s*```$/g, '').trim();\nlet out;\ntry { out = JSON.parse(raw.slice(raw.indexOf('{'), raw.lastIndexOf('}') + 1)); }\ncatch (e) { throw new Error('Модель вернула ответ не в формате JSON: ' + raw.slice(0, 300)); }\nconst src = $('Текст статьи').first().json;\nconst chatId = $('Проверка').first().json.chatId;\n// Экранируем символы разметки Markdown, чтобы Telegram не споткнулся о «_» и «*» в тексте\nconst esc = s => String(s).replace(/([_*`\\[])/g, '\\\\$1');\nconst preview = `📝 *Черновик новости для сайта*\\n\\n${esc(out.title)}\\n\\n${esc(out.text)}\\n\\nИсточник: ${esc(src.siteName)}\\n${esc(src.url)}`;\nreturn [{ json: {\n  chatId, title: String(out.title).trim(), text: String(out.text).trim(),\n  sourceTitle: src.siteName, sourceUrl: src.url, preview: preview.slice(0, 3900),\n}}];"
      },
