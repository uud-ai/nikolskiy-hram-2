      "id": "1b9840cc-a660-4dea-8bc7-21d3121ce2e6",
      "name": "Получить news.json",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2280,
        120
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Добавляем новость в news.json и готовим коммит\nconst cfg = $('Настройки').first().json;\nconst news = $('Подготовка черновика').first().json;\nconst file = $json;                                   // ответ GitHub API: content (base64) + sha\nconst current = JSON.parse(Buffer.from(file.content, 'base64').toString('utf8'));\nconst items = Array.isArray(current.items) ? current.items : [];\n\nif (items.some(i => i.sourceUrl === news.sourceUrl)) {\n  throw new Error('Эта новость уже есть на сайте.');\n}\nitems.unshift({\n  id: `${$now.toFormat('yyyyMMdd-HHmmss')}`,\n  title: news.title,\n  date: $now.setZone('Asia/Chita').toFormat('yyyy-MM-dd'),\n  text: news.text,\n  sourceTitle: news.sourceTitle,\n  sourceUrl: news.sourceUrl,\n});\nconst body = JSON.stringify({ items }, null, 2) + '\\n';\nreturn [{ json: {\n  message: `Новость: ${news.title}`,\n  content: Buffer.from(body, 'utf8').toString('base64'),\n  sha: file.sha,\n  branch: cfg.branch,\n}}];"
      },
